# Browser-safe Cloudinary product environment name.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Server-only Cloudinary API credentials.
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Server-only Supabase credentials. Use the secret/service-role key only on the server.
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Server-only embedding provider key.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Limits and canonical URLs.
MAX_VIDEO_BYTES=104857600
NEXT_PUBLIC_SITE_URL=http://localhost:3000
